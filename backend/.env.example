# Copy this file to .env and fill in your real API key.
# .env itself is gitignored and should NEVER be committed.

# Which LLM provider to use for name/email extraction: "groq" (default) or "gemini"
LLM_PROVIDER=groq

# Which model to use, for whichever provider is active above
LLM_MODEL=llama-3.1-8b-instant

# Only fill in the key for whichever provider you're using
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=
